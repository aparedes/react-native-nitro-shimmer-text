{
  "name": "react-native-nitro-shimmer-text",
  "version": "0.1.0",
  "description": "Native shimmering text view for React Native, built with Nitro Modules",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "bunx oxlint .",
    "lint:fix": "bunx oxlint --fix .",
    "fmt": "bunx oxfmt .",
    "fmt:check": "bunx oxfmt --check .",
    "clean": "git clean -dfX",
    "release": "semantic-release",
    "build": "bun run typecheck && bob build && node scripts/copy-build-assets.cjs",
    "test:package": "bun run build && node --test scripts/__tests__/package.test.cjs",
    "codegen": "nitrogen --logLevel=\"debug\" && bun run build && node post-script.js",
    "prepare": "lefthook install"
  },
  "keywords": [
    "react-native",
    "react-native-nitro-shimmer-text",
    "shimmer",
    "nitro",
    "text"
  ],
  "files": [
    "src",
    "lib",
    "nitrogen",
    "nitro.json",
    "android/build.gradle",
    "android/fix-prefab.gradle",
    "android/gradle.properties",
    "android/CMakeLists.txt",
    "android/src",
    "ios/**/*.h",
    "ios/**/*.m",
    "ios/**/*.mm",
    "ios/**/*.cpp",
    "ios/**/*.swift",
    "*.podspec",
    "README.md"
  ],
  "workspaces": [
    "example"
  ],
  "repository": "https://github.com/aparedes/react-native-nitro-shimmer-text.git",
  "author": "Alejandro Paredes Alva",
  "license": "MIT",
  "bugs": "https://github.com/aparedes/react-native-nitro-shimmer-text/issues",
  "homepage": "https://github.com/aparedes/react-native-nitro-shimmer-text#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/jest": "^29.5.12",
    "@types/react": "19.2.0",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "lefthook": "^2.1.14",
    "nitrogen": "0.37.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-plugin-react-doctor": "^0.9.14",
    "oxlint-plugin-react-native": "^0.2.35",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-builder-bob": "^0.40.18",
    "react-native-nitro-modules": "0.37.1",
    "semantic-release": "^25.0.3",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.78.0",
    "react-native-nitro-modules": "^0.37.1"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  },
  "trustedDependencies": [
    "lefthook"
  ]
}
